# Workers' default for static assets is "cache, but revalidate every time", which would put a
# conditional request in front of the 663 KB compiler on every load. Everything under `_nuxt/`
# is content-hashed by Vite — the wasm included — so the URL changes whenever the bytes do and
# it can be pinned indefinitely.
/_nuxt/*
  Cache-Control: public, max-age=31536000, immutable
