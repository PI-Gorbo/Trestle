WHITESPACE = _{ " " | "\t" | NEWLINE }
COMMENT    = _{ "//" ~ (!NEWLINE ~ ANY)* }

// lexical atoms
alphanumeric_word_boundary = @{ ASCII_ALPHANUMERIC | "_" }
alpha_word_boundary        = @{ ASCII_ALPHA | "_" }
let_kw                     = @{ "let" ~ !(alphanumeric_word_boundary) }

identifier                                = @{ !let_kw ~ (alpha_word_boundary) ~ (alphanumeric_word_boundary)* }
type_declaration                          =  { ":" ~ identifier }
optional_type_declaration                 =  { type_declaration? }
identifier_with_optional_type_declaration =  { identifier ~ (type_declaration)? }
identifier_with_type_declaration = { identifier ~ type_declaration }

// program & statements
program = { SOI ~ expr+ ~ EOI }

int              = @{ ASCII_DIGIT+ }
string_character = @{ "\\" ~ ANY | !("\"" | "\\") ~ ANY }
string           = @{ "\"" ~ (string_character)* ~ "\"" }
float            = @{ int ~ "." ~ int }
true             = @{ "true" ~ !(alphanumeric_word_boundary) }
false            = @{ "false" ~ !(alphanumeric_word_boundary) }
boolean          =  { true | false }
unit             = @{ "unit" }
record           = { "{" ~  ( identifier ~ ":" ~ expr ~ ("," ~ identifier ~ ":" ~ expr)* )? ~ "}" }
literal          =  { record | boolean | unit | string | float | int  }


// Primary = most atomic element.
// ! = Escape from parent 'no-whitespace' rule
primary_base = !{ literal | identifier | "(" ~ expr ~ ")" }
primary_postfix = !{ field_access | call_arguments }
field_access = { "." ~ identifier }
call_arguments = { "(" ~ comma_separated_list_of_expressions? ~")"}
// $ = No whitespace beween sections.
primary = ${ primary_base ~ primary_postfix* }

binary_expression = { prefix_operator* ~ primary ~ (infix_operator ~ prefix_operator* ~ primary)* }

infix_operator = _{ and | or | add | subtract | multiply | divide | eq | neq | le | ge | lt | gt | pipe }
add            =  { "+" }
subtract       =  { "-" }
multiply       =  { "*" }
divide         =  { "/" }
and            =  { "&&" }
or             =  { "||" }
eq             =  { "==" }
neq            =  { "!=" }
le             =  { "<=" }
ge             =  { ">=" }
lt             =  { "<" }
gt             =  { ">" }
pipe           =  { "|>" }


prefix_operator = _{ negate | logical_not }
negate          =  { "-" }
logical_not     =  { "!" }


lambda_expression                   = {
    "(" ~ (identifier_with_optional_type_declaration ~ ("," ~ identifier_with_optional_type_declaration)*)? ~ ")" ~ optional_type_declaration ~ "=>" ~ expr
}
comma_separated_list_of_expressions = { expr ~ ("," ~ expr)* }
let_expression                      = { let_kw ~ identifier_with_optional_type_declaration ~ "=" ~ expr }
list_of_expressions                 = { "{" ~ expr+ ~ "}" }
if_expression                       = { "if" ~ "(" ~ expr ~ ")" ~ expr ~ ("else" ~ expr)? }
type_declaration_expression                     = { "type" ~ identifier ~ "=" ~ type_expression }

expr = { type_declaration_expression | let_expression | list_of_expressions | lambda_expression | if_expression | binary_expression }

comma_separated_list_of_type_expressions = _{ identifier_with_type_declaration ~ ("," ~ identifier_with_type_declaration)* }
record_type_expression = { "{" ~ comma_separated_list_of_type_expressions? ~ "}" }
type_identifier = { identifier }
type_expression         = { record_type_expression | type_identifier }